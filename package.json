{
  "name": "cinemax",
  "version": "1.0.0",
  "private": true,
  "description": "Cinemax cinema booking site with PayMongo payments, on Postgres/Supabase",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "reset": "node --env-file-if-exists=.env db/reset.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
